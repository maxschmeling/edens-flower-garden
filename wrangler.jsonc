{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edens-flower-garden",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
